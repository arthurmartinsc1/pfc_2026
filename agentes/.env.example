# Conexao com o Postgres compartilhado com a interface Next.js (banco subido pelo
# docker-compose.yml do repo da interface, criado via Prisma - nao rodamos
# migration nem create_all aqui, so lemos/escrevemos nas tabelas existentes).
# O parametro ?schema= (sintaxe do Prisma) e removido automaticamente em db.py
# antes de passar pro psycopg2.
# Se este backend rodar dentro de outro container Docker fora da rede do
# docker-compose da interface, troque "localhost" por "host.docker.internal"
# (Mac/Windows) ou coloque os dois containers na mesma rede docker.
DATABASE_URL=postgresql://app:app@localhost:5434/noticias?schema=public

# Token do HuggingFace (necessario para baixar os modelos).
# NUNCA commitar um token real - gere um em https://huggingface.co/settings/tokens
HF_TOKEN=hf_xxx

# Diretorio local de cache dos modelos HF (substitui o cache no Google Drive dos notebooks).
HF_HOME=./hf_cache

# Polling
POLL_INTERVAL_SECONDS=60

# Parametros do buscador. Modelo pequeno (roda em CPU/MPS local, ex: MacBook Air M4 16GB)
BUSCADOR_MODEL=Qwen/Qwen2.5-1.5B-Instruct
BUSCADOR_N_CANDIDATOS=10
BUSCADOR_TOP_K=2
BUSCADOR_LINGUA=pt
BUSCADOR_PAIS=BR
BUSCADOR_MAX_IDADE_DIAS=7

# Parametros do resumidor. Modelo um pouco maior mas ainda leve o suficiente para
# rodar junto com o do buscador em 16GB de RAM unificada (MPS/fp16, sem CUDA).
RESUMIDOR_MODEL=Qwen/Qwen2.5-3B-Instruct
