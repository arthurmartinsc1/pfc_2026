# Conexao com o Postgres compartilhado com a interface Next.js (banco subido pelo
# docker-compose.yml do repo da interface, criado via Prisma - nao rodamos
# migration nem create_all aqui, so lemos/escrevemos nas tabelas existentes).
# O parametro ?schema= (sintaxe do Prisma) e removido automaticamente em db.py
# antes de passar pro psycopg2.
# Se este backend rodar dentro de outro container Docker fora da rede do
# docker-compose da interface, troque "localhost" por "host.docker.internal"
# (Mac/Windows) ou coloque os dois containers na mesma rede docker.
DATABASE_URL=postgresql://app:app@localhost:5434/noticias?schema=public

# LLMs servidos remotamente via vLLM (API compativel com OpenAI) numa VM com
# GPU, acessada pela VPN. api_key e o mesmo valor passado em --api-key no
# `vllm serve` (ex: "EMPTY" nao significa sem auth, e um shared secret literal).
LLM_API_KEY=EMPTY
# Timeout (segundos) por chamada de geracao. Evita que uma trava no servidor
# remoto (rede caindo, vLLM sobrecarregado) prenda o poller para sempre.
LLM_TIMEOUT_SECONDS=240

# Polling
POLL_INTERVAL_SECONDS=60

# Parametros do buscador (selecao de artigos via LLM).
BUSCADOR_LLM_BASE_URL=http://<IP_VPN_DA_VM>:8000/v1
BUSCADOR_LLM_MODEL=qwen
BUSCADOR_N_CANDIDATOS=10
BUSCADOR_TOP_K=2
BUSCADOR_LINGUA=pt
BUSCADOR_PAIS=BR
BUSCADOR_MAX_IDADE_DIAS=7

# Parametros do resumidor (geracao do resumo via LLM).
RESUMIDOR_LLM_BASE_URL=http://<IP_VPN_DA_VM>:8003/v1
RESUMIDOR_LLM_MODEL=gemma
